exports[`Mobile Responsive Page Snapshot & Layout Verification Viewport: iPhone 12/13/14 (390px) renders Products catalog page on mobile 1`] = `
<DocumentFragment>
  <div
    class="catalog-root-wrapper"
  >
    <div
      class="catalog-container"
    >
      <div
        class="catalog-main-layout"
      >
        <aside
          aria-label="Product Filters"
          class="catalog-desktop-sidebar"
        >
          <div
            class="catalog-sidebar-inner"
          >
            <div
              class="filter-group category-group"
            >
              <h3
                class="filter-group-title"
              >
                Category
              </h3>
              <ul
                class="category-link-list"
              >
                <li
                  class=""
                >
                  <button
                    class="category-link-btn"
                    type="button"
                  >
                    All Products
                  </button>
                </li>
                <li
                  class="active"
                >
                  <button
                    class="category-link-btn"
                    type="button"
                  >
                    Watches
                  </button>
                </li>
                <li
                  class=""
                >
                  <button
                    class="category-link-btn"
                    type="button"
                  >
                    Shoes
                  </button>
                </li>
              </ul>
            </div>
            <div
              class="sidebar-divider"
            />
            <div
              class="filter-by-header"
            >
              <span
                class="filter-by-label"
              >
                Filter by :
              </span>
            </div>
            <div
              class="filter-group"
            >
