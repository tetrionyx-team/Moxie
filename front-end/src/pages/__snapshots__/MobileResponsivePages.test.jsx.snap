exports[`Mobile Responsive Page Snapshot & Layout Verification Viewport: iPhone 14/15 Pro Max (430px) renders Products catalog page on mobile 1`] = `
<DocumentFragment>
  <div
    class="catalog-root-wrapper"
  >
    <div
      class="catalog-container"
    >
      <div
        class="catalog-main-layout"
      >
        <aside
          aria-label="Product Filters"
          class="catalog-desktop-sidebar"
        >
          <div
            class="catalog-sidebar-inner"
          >
            <div
              class="filter-group category-group"
            >
              <h3
                class="filter-group-title"
              >
                Category
              </h3>
              <ul
                class="category-link-list"
              >
                <li
                  class=""
                >
                  <button
                    class="category-link-btn"
                    type="button"
                  >
                    All Products
                  </button>
                </li>
                <li
                  class="active"
                >
                  <button
                    class="category-link-btn"
                    type="button"
                  >
                    Watches
                  </button>
                </li>
                <li
                  class=""
                >
                  <button
                    class="category-link-btn"
                    type="button"
                  >
                    Shoes
                  </button>
                </li>
              </ul>
            </div>
            <div
              class="sidebar-divider"
            />
            <div
              class="filter-by-header"
            >
              <span
                class="filter-by-label"
              >
                Filter by :
              </span>
            </div>
            <div
              class="filter-group"
            >
              <div
                class="filter-accordion-head-wrapper"
              >
                <button
                  class="filter-accordion-head"
                  type="button"
                >
                  <span>
                    Price
                  </span>
                  <svg
                    fill="none"
                    height="1em"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="1em"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <polyline
                      points="18 15 12 9 6 15"
                    />
                  </svg>
                </button>
              </div>
              <div
                class="filter-price-box"
              >
                <div
                  class="price-display-row"
                >
                  <span>
                    ₹2,900
                  </span>
                  <strong
                    class="price-current-value"
                  >
                    ₹5,000
                  </strong>
                </div>
                <input
                  aria-label="Filter products by price"
                  class="price-range-slider"
                  max="5000"
                  min="2900"
                  step="50"
                  type="range"
                  value="5000"
                />
              </div>
            </div>
            <div
              class="filter-group"
            >
              <button
                class="filter-accordion-head"
                type="button"
              >
                <span>
                  Availability
                </span>
                <svg
                  fill="none"
                  height="1em"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="1em"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <polyline
                    points="18 15 12 9 6 15"
                  />
                </svg>
              </button>
              <div
                class="filter-options-list"
              >
                <label
                  class="filter-radio-item"
                >
                  <input
                    checked=""
                    name="availability"
                    type="radio"
                  />
                  <span
                    class="radio-custom"
                  />
                  <span
                    class="filter-option-name"
                  >
                    All Items
                  </span>
                </label>
                <label
                  class="filter-radio-item"
                >
                  <input
                    name="availability"
                    type="radio"
                  />
                  <span
                    class="radio-custom"
                  />
                  <span
                    class="filter-option-name"
                  >
                    In Stock
                  </span>
                </label>
                <label
                  class="filter-radio-item"
                >
                  <input
                    name="availability"
                    type="radio"
                  />
                  <span
                    class="radio-custom"
                  />
                  <span
                    class="filter-option-name"
                  >
                    Out of Stock
                  </span>
                </label>
              </div>
            </div>
            <div
              class="sidebar-action-buttons"
            >
              <button
                class="catalog-clear-all-btn"
                type="button"
              >
                <svg
                  fill="none"
                  height="1em"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
