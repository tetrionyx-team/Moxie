exports[`Mobile Responsive Page Snapshot & Layout Verification Viewport: Galaxy S8/S9 (360px) renders Cart page on mobile 1`] = `
<DocumentFragment>
  <div
    class="cart-page-wrapper"
  >
    <div
      class="cart-page-container"
    >
      <div
        class="cart-empty-state-wrapper"
      >
        <div
          class="cart-empty-state-card"
        >
          <span
            class="cart-empty-eyebrow"
          >
            YOUR BAG
          </span>
          <div
            class="empty-cart-icon-circle"
          >
            <svg
              fill="none"
              height="36"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              viewBox="0 0 24 24"
              width="36"
            >
              <path
                d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"
              />
              <line
                x1="3"
                x2="21"
                y1="6"
                y2="6"
              />
              <path
                d="M16 10a4 4 0 0 1-8 0"
              />
            </svg>
          </div>
          <h2
            class="empty-cart-heading"
          >
            Your shopping bag is empty
          </h2>
          <p
            class="empty-cart-text"
          >
            Looks like you haven't added anything yet.
            <br
              class="empty-cart-br"
            />
            Explore our curated collection and find your next favourite.
          </p>
          <a
            class="empty-cart-cta-btn"
            href="/products"
          >
            CONTINUE SHOPPING
          </a>
          <a
            class="empty-cart-secondary-link"
            href="/products"
          >
            Explore Products →
          </a>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

exports[`Mobile Responsive Page Snapshot & Layout Verification Viewport: Galaxy S8/S9 (360px) renders Checkout page on mobile 1`] = `
<DocumentFragment>
  <main
    class="checkout-page-wrapper"
  >
    <div
      class="checkout-page-container"
    >
      <div
        class="checkout-empty-card"
      >
        <div
          class="empty-cart-icon-circle"
        >
          🛒
        </div>
        <h2
          class="empty-cart-heading"
        >
          Your cart is empty
        </h2>
        <p
          class="empty-cart-text"
        >
          Please add your favorite Moxie styles before proceeding to checkout.
        </p>
        <a
          class="empty-cart-cta-btn"
          href="/products"
        >
          EXPLORE PRODUCTS
        </a>
      </div>
    </div>
  </main>
</DocumentFragment>
`;

