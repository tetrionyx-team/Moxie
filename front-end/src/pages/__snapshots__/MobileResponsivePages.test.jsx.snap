              style="background: rgb(251, 247, 239); border: 1px solid rgba(201, 155, 69, 0.4); border-left: 4px solid #c99b45; border-radius: 8px; padding: 14px 18px; margin: 12px 0px 18px; color: rgb(7, 20, 38);"
