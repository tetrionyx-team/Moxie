              viewBox="0 0 24 24"
              width="1em"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="11"
                cy="11"
                r="8"
              />
              <path
                d="m21 21-4.3-4.3"
              />
            </svg>
            <input
              aria-label="Order ID or Tracking Number"
              class="search-text-input"
              placeholder="Enter Order ID (MOX-0004), ST Courier AWB, or India Post Consignment Number"
              type="text"
              value=""
            />
          </div>
          <button
            class="btn-track-submit"
