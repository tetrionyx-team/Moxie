          </button>
        </form>
        <div
          class="courier-select-row"
        >
          <span
            class="courier-select-label"
          >
            Courier Service
          </span>
          <div
            class="courier-pills-wrap"
          >
            <button
              class="courier-pill-btn active"
              type="button"
            >
              Auto Detect
            </button>
            <button
              class="courier-pill-btn "
              type="button"
            >
              ST Courier
            </button>
            <button
              class="courier-pill-btn "
              type="button"
            >
              India Post
            </button>
          </div>
        </div>
      </div>
      <section
        class="track-how-it-works"
      >
        <div
          class="section-divider-title"
        >
          <span
            class="divider-line"
          />
          <span
            class="divider-text"
          >
            How It Works
          </span>
          <span
            class="divider-line"
          />
        </div>
        <div
          class="process-cards-grid"
        >
          <div
            class="process-card"
          >
            <div
              class="process-icon-circle"
            >
              <svg
                fill="none"
                height="26"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="26"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"
