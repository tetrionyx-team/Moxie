        >
          <span
            class="courier-select-label"
          >
            Courier Service
          </span>
          <div
            class="courier-pills-wrap"
          >
            <button
              class="courier-pill-btn active"
              type="button"
            >
              Auto Detect
            </button>
            <button
              class="courier-pill-btn "
              type="button"
            >
              ST Courier
            </button>
            <button
              class="courier-pill-btn "
              type="button"
            >
              India Post
            </button>
          </div>
