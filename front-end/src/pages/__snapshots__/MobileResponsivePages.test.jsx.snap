          <a
            class="empty-cart-cta-btn"
            href="/products"
          >
            CONTINUE SHOPPING
          </a>
          <a
            class="empty-cart-secondary-link"
            href="/products"
          >
            Explore Products →
          </a>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

