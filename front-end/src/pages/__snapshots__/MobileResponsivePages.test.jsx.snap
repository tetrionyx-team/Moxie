                  </svg>
                  <span
                    class="premium-btn-sep"
                  />
                  <span
                    class="premium-btn-text"
                  >
                    OUT OF STOCK
                  </span>
                  <svg
                    class="premium-arrow-icon"
                    fill="none"
                    height="16"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                    width="16"
                  >
                    <path
                      d="M9 5l7 7-7 7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              </div>
            </article>
          </div>
        </main>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

