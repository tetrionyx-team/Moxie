                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="12"
                  cy="12"
                  r="10"
                />
                <path
                  d="m9 12 2 2 4-4"
                />
              </svg>
            </div>
            <h3
              class="process-card-title"
            >
              Delivered
