exports[`Mobile Responsive Page Snapshot & Layout Verification Viewport: iPhone 12/13/14 (390px) renders Track Order page on mobile 1`] = `
<DocumentFragment>
  <div
    class="moxie-track-search-page"
  >
    <section
      class="track-hero-section"
    >
      <div
        class="track-hero-inner"
      >
        <div
          class="track-hero-content"
        >
          <span
            class="hero-gold-badge"
          >
            ✧ MOXIE DELIVERY
          </span>
          <h1
            class="hero-main-title"
          >
            Track Your Order
          </h1>
          <p
            class="hero-subtitle"
          >
            From our store to your doorstep — follow every step of your MOXIE order.
          </p>
        </div>
        <div
          aria-hidden="true"
          class="track-hero-box-visual"
        >
          <div
            class="luxury-box-card"
          >
            <span
              class="box-brand-logo"
            >
              MOXIE
            </span>
            <span
              class="box-tagline"
            >
              WEAR YOUR MOOD
            </span>
          </div>
        </div>
      </div>
    </section>
    <div
      class="track-search-container"
    >
      <div
        class="track-search-card"
      >
        <div
          class="search-card-header"
        >
          <h2
            class="search-card-title"
          >
            Find Your Shipment
          </h2>
          <p
            class="search-card-sub"
          >
            Enter your Order ID, ST Courier AWB, or India Post Consignment Number
          </p>
        </div>
        <form
          class="track-search-form"
        >
          <div
            class="search-input-wrapper"
          >
            <svg
              class="search-input-icon"
              fill="none"
              height="1em"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
