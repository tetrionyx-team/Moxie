            </p>
          </div>
          <div
            class="process-card"
          >
            <div
              class="process-icon-circle"
            >
              <svg
                fill="none"
                height="26"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="26"
