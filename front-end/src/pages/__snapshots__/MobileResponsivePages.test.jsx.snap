          class="empty-cart-icon-circle"
        >
          🛒
        </div>
        <h2
          class="empty-cart-heading"
        >
          Your cart is empty
        </h2>
        <p
          class="empty-cart-text"
        >
          Please add your favorite Moxie styles before proceeding to checkout.
        </p>
        <a
          class="empty-cart-cta-btn"
          href="/products"
        >
          EXPLORE PRODUCTS
        </a>
      </div>
    </div>
  </main>
</DocumentFragment>
`;

