# =========================================================
# MOXIE REACT FRONTEND ENVIRONMENT VARIABLES (.env.example)
# =========================================================

# Production / Target API Base URL
REACT_APP_API_BASE_URL=

# Firebase Web Client Configuration (Public Web Credentials)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Razorpay Public Key ID (Frontend only receives public Key ID, NEVER the Key Secret)
REACT_APP_RAZORPAY_KEY_ID=

# WhatsApp Customer Support Number
REACT_APP_WHATSAPP_NUMBER=917871327802

# Feature Flags
REACT_APP_ENABLE_GOOGLE_AUTH=true

