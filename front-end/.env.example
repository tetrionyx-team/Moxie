# =========================================================
# MOXIE REACT FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================
# Copy this file to .env or .env.local and configure your environment.

# API / Backend URLs
# Local development default is http://127.0.0.1:8000
REACT_APP_API_URL=http://127.0.0.1:8000/api
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_BACKEND_URL=http://127.0.0.1:8000

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional Feature Flags & Payment
REACT_APP_ENABLE_GOOGLE_AUTH=true
REACT_APP_WHATSAPP_NUMBER=917871327802
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id
