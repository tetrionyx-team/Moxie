# =========================================================
# MOXIE BACKEND ENVIRONMENT VARIABLES (.env.example)
# =========================================================
# Copy this file to .env and configure values for your environment.
# In local development, you can leave DATABASE_URL blank to use SQLite.

# Django Core
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,moxie-backend-hexm.onrender.com

# Database (Render PostgreSQL Internal Connection String)
# Example: postgresql://moxie_db_user:password@dpg-xxxxx.singapore-postgres.render.com/moxie_db
DATABASE_URL=

# Email / 2FA OTP Delivery (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tetrionyx@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MOXIE <tetrionyx@gmail.com>

# Razorpay Payment Gateway (Backend Secrets - NEVER expose to frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin Bootstrap (ensure_admin management command)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend Origin, CORS & CSRF
FRONTEND_URL=https://moxie-jri0.onrender.com

# WhatsApp Integration (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Google OAuth / Firebase Admin Credentials
GOOGLE_CLIENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json