# =========================================================
# MOXIE BACKEND ENVIRONMENT VARIABLES (.env.example)
# =========================================================
# Copy this file to .env and configure values for your environment.
# In local development, you can leave DATABASE_URL blank to use SQLite.

# Django Core
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,moxie-backend-hexm.onrender.com

# Database (Render PostgreSQL Internal Connection String)
# Example: postgresql://moxie_db_user:password@dpg-xxxxx.singapore-postgres.render.com/moxie_db
DATABASE_URL=

# =========================================================
# EMAIL / 2FA OTP DELIVERY OPTIONS
# =========================================================
# Provider selection: 'gmail_api', 'smtp', or 'resend'
EMAIL_PROVIDER=gmail_api
DEFAULT_FROM_EMAIL=MOXIE <tetrionyx@gmail.com>

# OPTION 1: Gmail API over HTTPS (Recommended for Render Free Web Service)
# Uses OAuth 2.0 Server-Side Refresh Token. Works over HTTPS port 443 (no SMTP blocked ports).
GMAIL_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//04xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_SENDER_EMAIL=MOXIE <tetrionyx@gmail.com>

# OPTION 2: Localhost / Paid Instances Gmail SMTP
# Note: Render Free blocks SMTP ports (25, 465, 587). Use Option 1 on Free plan.
# EMAIL_PROVIDER=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tetrionyx@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=MOXIE <tetrionyx@gmail.com>

# OPTION 3: Resend HTTPS API (Alternative HTTPS Provider)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=MOXIE <onboarding@resend.dev>

# =========================================================
# PAYMENT & EXTERNAL SERVICES
# =========================================================
# Razorpay Payment Gateway (Backend Secrets - NEVER expose to frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin Bootstrap (ensure_admin management command)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend Origin, CORS & CSRF
FRONTEND_URL=https://moxie-jri0.onrender.com

# WhatsApp Integration (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Google OAuth / Firebase Admin Credentials
GOOGLE_CLIENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json