# =========================================================
# MOXIE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =========================================================
# Copy this file to .env and adjust values for your environment.
# In local development, you can leave DATABASE_URL commented to use SQLite.

# =========================================================
# DJANGO CORE SETTINGS
# =========================================================
DJANGO_SECRET_KEY=django-insecure-moxie-local-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DEBUG=True

# =========================================================
# DJANGO HOSTS
# =========================================================
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-app.onrender.com

# =========================================================
# CORS & CSRF
# =========================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-app.netlify.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000,http://localhost:8000,https://your-frontend-app.netlify.app

# =========================================================
# DATABASE
# =========================================================
# For Local Development: Leave DATABASE_URL commented out to automatically use SQLite (db.sqlite3)
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# =========================================================
# RAZORPAY (OPTIONAL FOR LOCAL DEV)
# =========================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# =========================================================
# GOOGLE OAUTH (OPTIONAL)
# =========================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =========================================================
# EMAIL BACKEND (ADMIN OTP / NOTIFICATIONS)
# =========================================================
# For Local Development (prints OTP directly to terminal console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Production (SMTP e.g. Gmail App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-admin-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-admin-email@gmail.com

# =========================================================
# PRODUCTION SECURITY (Set to False or omit in local dev)
# =========================================================
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False